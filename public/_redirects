# Cloudflare Pages redirects
# 404s are handled via a 404.html file at the root — no redirect rule needed

# /playoffs → current round page. Server-side 302, no "Redirecting..." flash.
/playoffs   /playoffs/2026   302
/playoffs/  /playoffs/2026   302

# /games/:id → Astro SSR route src/pages/games/[id].astro (injects per-game OG).
# /games/ (no id) is served by the prerendered static index automatically — the
# old "/games/ → /games/index.html 200" rewrite was a redirect loop and removed.

# Public Puck Passport profiles (/puck-passport/@handle) are served by the Astro
# SSR route src/pages/puck-passport/[handle].astro — no rewrite needed; the route
# reads the handle from the param and renders server-side with per-handle OG.

# /stats/leaderboards → /stats/skaters (URL rename, May 2026)
/stats/leaderboards   /stats/skaters   301
/stats/leaderboards/  /stats/skaters   301

# /cards → removed May 2026, canvas card generation moved to player pages
/cards    /stats/skaters   301
/cards/   /stats/skaters   301

# /_dev/* → not for public consumption; redirect to home in production
/_dev/*   /   302

# Puck Passport moved to its own product at puckpassport.app (PP-W035 cutover, activated
# 2026-09-25 after the iOS app went live). Public profiles (/puck-passport/@handle) stay on
# HGB until standalone public pages ship, so only the product surface redirects — never add
# /puck-passport/* here. ?ref=hgb lets puckpassport.app's anonymous tallies count these arrivals
# (a redirect keeps the original Referer, so the tag is the only way to see them).
/puck-passport            https://puckpassport.app/?ref=hgb   301
/puck-passport/           https://puckpassport.app/?ref=hgb   301
/puck-passport/arenas     https://puckpassport.app/?ref=hgb   301
/puck-passport/arenas/    https://puckpassport.app/?ref=hgb   301
/puck-passport/games      https://puckpassport.app/?ref=hgb   301
/puck-passport/games/     https://puckpassport.app/?ref=hgb   301
/puck-passport/players    https://puckpassport.app/?ref=hgb   301
/puck-passport/players/   https://puckpassport.app/?ref=hgb   301
