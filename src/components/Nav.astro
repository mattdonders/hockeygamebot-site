---
import { STATS_NAV_ITEMS, STATS_NAV_GROUP_LABELS, type StatsNavGroupId, isStatsNavItemActive, isStatsSectionActive } from '../lib/stats-nav';

const DROPDOWN_GROUPS: StatsNavGroupId[] = ['core', 'tools', 'history', 'studio', 'pwhl'];
const statsDropdownGroups = DROPDOWN_GROUPS
  .map(g => ({ label: STATS_NAV_GROUP_LABELS[g], items: STATS_NAV_ITEMS.filter(i => i.group === g) }))
  .filter(g => g.items.length > 0);

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function active(href: string): string {
  if (href === '/') return currentPath === '/' ? 'active' : '';
  return currentPath.startsWith(href) ? 'active' : '';
}

const statsActive = isStatsSectionActive(currentPath) ? 'active' : '';
const gamesActive = (active('/scoreboard') || active('/results') || active('/puck-passport')) ? 'active' : '';
const analysisActive = (active('/analysis') || active('/methodology')) ? 'active' : '';
const projectionsActive = (active('/projections') || active('/playoffs')) ? 'active' : '';
---

<!-- Flash prevention: read localStorage before first paint to avoid FOUC -->
<script is:inline>
  (function() {
    try {
      // Dark mode disabled until full pass is complete — force light for all visitors
      document.documentElement.setAttribute('data-theme', 'light');
    } catch(e) {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>

<nav class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="wordmark">hockey<span style="color: var(--hgb-red)">gamebot</span></a>
    <div class="nav-status" id="nav-status" style="display:none">
      <span class="pip" id="nav-pip"></span>
      <span id="nav-status-text"></span>
    </div>

    <!-- Desktop nav -->
    <nav class="nav-links" id="nav-links">
      <a href="/" class={active('/')}>Home</a><span class="sep"> · </span>

      <!-- Games dropdown -->
      <div class={`nav-dropdown ${gamesActive}`}>
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Games <span class="nav-caret">▾</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <a href="/results" role="menuitem" class={active('/results')}>Recent Games</a>
          <a href="/scoreboard" role="menuitem" class={active('/scoreboard')}>Live Scoreboard</a>
          <a href="/puck-passport" role="menuitem" class={active('/puck-passport')}>Puck Passport</a>
        </div>
      </div>
      <span class="sep"> · </span>

      <!-- Projections dropdown -->
      <div class={`nav-dropdown ${projectionsActive}`}>
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Projections <span class="nav-caret">▾</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <a href="/projections" role="menuitem" class={active('/projections')}>Season Projections</a>
          <a href="/playoffs/2026" role="menuitem" class={active('/playoffs')}>Playoff Projections</a>
        </div>
      </div>
      <span class="sep"> · </span>

      <!-- Stats dropdown -->
      <div class={`nav-dropdown ${statsActive}`}>
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Stats <span class="nav-caret">▾</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          {statsDropdownGroups.map(({ label, items }) => (
            <Fragment>
              <span class="dd-group-label">{label}</span>
              {items.map(item => (
                <a href={item.href} role="menuitem" class={isStatsNavItemActive(item, currentPath) ? 'active' : ''}>
                  {item.label}{item.badge && <span class="beta-pill">{item.badge}</span>}
                </a>
              ))}
            </Fragment>
          ))}
        </div>
      </div>
      <span class="sep"> · </span>

      <!-- Analysis dropdown -->
      <div class={`nav-dropdown ${analysisActive}`}>
        <button class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Analysis <span class="nav-caret">▾</span>
        </button>
        <div class="nav-dropdown-menu" role="menu">
          <a href="/analysis" role="menuitem" class={active('/analysis')}>Articles</a>
          <a href="/methodology" role="menuitem" class={active('/methodology')}>Methodology</a>
        </div>
      </div>
      <span class="sep"> · </span>

      <a href="/teams" class={active('/teams')}>Teams</a><span class="sep"> · </span>
      <a href="/support" class={active('/support')}>Support</a><span class="sep"> · </span>
      <a href="/account" class={active('/account')}>Account</a>
      <!-- Admin-only. Hidden by default; the auth script at the bottom reveals it
           after confirming is_admin via /v1/admin/whoami (cached per session). -->
      <span class="sep nav-admin-item" style="display:none"> · </span><a href="/admin" class={`nav-admin-item ${active('/admin')}`} style="display:none">Admin</a>

      <!-- Theme toggle — hidden until dark mode pass is complete -->
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" style="display:none">
        <!-- Moon: shown in light mode -->
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <!-- Sun: shown in dark mode -->
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
    </nav>

    <!-- Mobile hamburger -->
    <button class="theme-toggle theme-toggle-mobile" id="theme-toggle-mobile" aria-label="Toggle dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
    </button>
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav-mobile" id="nav-mobile" aria-hidden="true">
    <a href="/" class={active('/')}>Home</a>
    <div class="nav-mobile-group">
      <button class="nav-mobile-label" type="button" aria-expanded="false">Games<span class="nav-mobile-chev" aria-hidden="true"></span></button>
      <a href="/results" class={active('/results')}>Recent Games</a>
      <a href="/scoreboard" class={active('/scoreboard')}>Live Scoreboard</a>
      <a href="/puck-passport" class={active('/puck-passport')}>Puck Passport</a>
    </div>
    <div class="nav-mobile-group">
      <button class="nav-mobile-label" type="button" aria-expanded="false">Projections<span class="nav-mobile-chev" aria-hidden="true"></span></button>
      <a href="/projections" class={active('/projections')}>Season Projections</a>
      <a href="/playoffs/2026" class={active('/playoffs')}>Playoff Projections</a>
    </div>
    <div class="nav-mobile-group">
      <button class="nav-mobile-label" type="button" aria-expanded="false">Stats<span class="nav-mobile-chev" aria-hidden="true"></span></button>
      {STATS_NAV_ITEMS.map((item) => (
        <a href={item.href} class={isStatsNavItemActive(item, currentPath) ? 'active' : ''}>{item.label}</a>
      ))}
    </div>
    <div class="nav-mobile-group">
      <button class="nav-mobile-label" type="button" aria-expanded="false">Analysis<span class="nav-mobile-chev" aria-hidden="true"></span></button>
      <a href="/analysis" class={active('/analysis')}>Articles</a>
      <a href="/methodology" class={active('/methodology')}>Methodology</a>
    </div>
    <a href="/teams" class={active('/teams')}>Teams</a>
    <a href="/support" class={active('/support')}>Support</a>
    <a href="/account" class={active('/account')}>Account</a>
    <!-- Admin-only (revealed client-side after is_admin check). -->
    <a href="/admin" class={`nav-admin-item ${active('/admin')}`} style="display:none">Admin</a>
  </div>
</nav>

<style is:global>
/* ─────────────────────────────────────────────────────────────
   DARK MODE TARGETED FIXES
   Elements that use var(--ink) as a dark background surface
   (inverted card pattern: dark bg + light text) need explicit
   overrides since --ink flips to cream in dark mode.
   ───────────────────────────────────────────────────────────── */
html[data-theme="dark"] footer,
html[data-theme="dark"] .cta-card {
  background: #111113;
}

/* Positive stat green: dark #14803c is illegible on dark bg */
html[data-theme="dark"] .rapm-val.pos,
html[data-theme="dark"] .stat-val.war-pos,
html[data-theme="dark"] .peer-rapm.pos,
html[data-theme="dark"] .gl-win,
html[data-theme="dark"] .gl-imp.pos {
  color: #22c55e;
}

/* Team logo: remove the cream bg square; SVG logos read on dark card surface */
html[data-theme="dark"] .team-logo {
  background: transparent;
  border-color: transparent;
}

/* ─────────────────────────────────────────────────────────────
   THEME TOGGLE BUTTON
   ───────────────────────────────────────────────────────────── */
.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  margin-left: 10px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--ink-48);
  transition: color .15s;
  padding: 0;
  flex-shrink: 0;
}
.theme-toggle:hover { color: var(--ink); }
.theme-toggle svg { width: 15px; height: 15px; }

/* Icon visibility: moon shown in light, sun shown in dark */
.icon-sun  { display: none; }
.icon-moon { display: block; }
html[data-theme="dark"] .icon-sun  { display: block; }
html[data-theme="dark"] .icon-moon { display: none; }

/* Mobile toggle: visible only on mobile breakpoint */
.theme-toggle-mobile {
  display: none;
  margin-left: auto;
  margin-right: 4px;
}
@media (max-width: 768px) {
  .theme-toggle-mobile { display: inline-flex; }
}

/* ── Base nav ── */
.nav {
  background: var(--bg);
  border-bottom: 1px solid var(--ink-14);
  position: sticky;
  top: 0;
  z-index: 100;
}
.nav .wrap.nav-inner {
  display: flex;
  align-items: center;
  height: var(--nav-height);
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}
@media (max-width: 480px) {
  .nav .wrap.nav-inner { padding: 0 16px; }
}
.wordmark {
  font-family: var(--display);
  font-weight: 800;
  font-size: 21px;
  letter-spacing: 0.04em;
  text-transform: lowercase;
  display: inline-flex;
  align-items: center;
  line-height: 1;
  color: var(--site-white);
  text-decoration: none;
  flex-shrink: 0;
}
.nav-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-left: 20px;
  font-family: var(--body);  /* Barlow — nav status label text, not numeric */
  font-weight: 600;
  font-size: 10.5px;
  color: var(--ink-48);
  letter-spacing: 0.04em;
}
.nav-status .pip {
  width: 6px; height: 6px;
  background: var(--red);
  border-radius: 50%;
  animation: nav-pip-pulse 1.4s infinite;
}
@keyframes nav-pip-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.25; }
}

/* ── Desktop nav links ── */
.nav-links {
  margin-left: auto;
  display: flex;
  align-items: center;
  font-family: var(--body);
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.nav-links > a {
  padding: 5px 12px;
  color: var(--ink-48);
  text-decoration: none;
  transition: color .15s;
}
.nav-links > a:hover,
.nav-links > a.active { color: var(--ink); }
.nav-links .sep { color: var(--ink-20); }

/* ── Stats dropdown ── */
.nav-dropdown {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.nav-dropdown-trigger {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 12px;
  color: var(--ink-48);
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--body);
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: color .15s;
}
.nav-dropdown-trigger:hover,
.nav-dropdown.active .nav-dropdown-trigger { color: var(--ink); }
.nav-caret {
  font-size: 9px;
  opacity: 0.5;
  transition: transform .15s;
}
.nav-dropdown.open .nav-caret { transform: rotate(180deg); }

.nav-dropdown-menu {
  display: none;
  position: absolute;
  top: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%);
  min-width: 160px;
  background: var(--surface);
  border: 1.5px solid var(--ink-14);
  box-shadow: 0 4px 16px var(--ink-10);
  z-index: 200;
  flex-direction: column;
}
.nav-dropdown.open .nav-dropdown-menu { display: flex; }
.nav-dropdown-menu a {
  padding: 10px 16px;
  color: var(--ink-56);
  font-family: var(--body);
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  transition: background .1s, color .1s;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 8px;
}
.nav-dropdown-menu a:hover { background: var(--bg); color: var(--ink); }
.nav-dropdown-menu a.active { color: var(--ink); }
.dd-group-label {
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-32);
  padding: 8px 16px 4px;
  pointer-events: none;
}
.nav-dropdown-menu a + .dd-group-label {
  border-top: 1px solid var(--ink-06);
  padding-top: 10px;
  margin-top: 4px;
}
.nav-dropdown-menu {
  min-width: 180px;
}
.beta-pill {
  font-family: var(--body);  /* Barlow — badge label, not numeric */
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.08em;
  padding: 1px 5px;
  background: var(--ink-10);
  color: var(--ink-48);
  text-transform: uppercase;
}

/* ── Hamburger button ── */
.nav-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 36px;
  height: 36px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
}
.nav-hamburger span {
  display: block;
  height: 2px;
  background: var(--ink);
  border-radius: 1px;
  transition: transform .2s, opacity .2s;
}
.nav-hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.nav-hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ── Mobile menu ── */
.nav-mobile {
  display: none;
  flex-direction: column;
  border-top: 1px solid var(--ink-14);
  background: var(--bg);
  padding: 8px 0 16px;
}
/* `.open` only reveals the menu at the mobile breakpoint (see the media query) —
   never on desktop, so a menu left open across a resize past 768px can't get stuck
   visible. The resize handler additionally clears .open + the scroll lock. */
.nav-mobile > a,
.nav-mobile-group a {
  padding: 10px 24px;
  color: var(--ink-48);
  font-family: var(--body);
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  transition: color .1s;
}
.nav-mobile > a:hover,
.nav-mobile > a.active,
.nav-mobile-group a:hover,
.nav-mobile-group a.active { color: var(--ink); }
.nav-mobile-group { display: flex; flex-direction: column; }
/* Group label is now a tappable button (collapsible section). Collapsed by default:
   the group's links are hidden until the group gets `.open`. Shortens the tall menu
   so it fits without the page-scroll trap. */
.nav-mobile-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 14px 24px;
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--body);  /* Barlow — mobile nav group label, not numeric */
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-48);
  text-align: left;
}
.nav-mobile-label:hover { color: var(--ink); }
.nav-mobile-chev {
  width: 8px; height: 8px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
  transition: transform .15s;
  margin-left: 12px;
}
.nav-mobile-group.open > .nav-mobile-label { color: var(--ink); }
.nav-mobile-group.open .nav-mobile-chev { transform: rotate(-135deg); }
/* Collapsed by default — hide the group's links until `.open`. */
.nav-mobile-group:not(.open) > a { display: none; }
.nav-mobile-group a { padding-left: 36px; }

/* ── Responsive ── */
@media (max-width: 768px) {
  .nav-links  { display: none; }
  .nav-hamburger { display: flex; }
  /* The open mobile menu is its OWN scroll container (fixed below the bar), so
     scrolling the menu never scroll-chains to the page behind it. Paired with the
     body-scroll lock in the script (html.nav-locked). */
  .nav-mobile.open {
    display: flex;
    position: fixed;
    left: 0; right: 0; bottom: 0;
    top: var(--nav-height, 60px);
    max-height: calc(100dvh - var(--nav-height, 60px));
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    z-index: 200;
  }
}
/* Lock the page behind the open mobile menu (set by the hamburger handler). */
html.nav-locked, html.nav-locked body { overflow: hidden; }
</style>

<script>
// Dropdown toggle — close all others when opening one
const allDropdowns = document.querySelectorAll('.nav-dropdown');
allDropdowns.forEach(dropdown => {
  const trigger = dropdown.querySelector('.nav-dropdown-trigger');
  trigger?.addEventListener('click', e => {
    e.stopPropagation();
    const isOpen = dropdown.classList.contains('open');
    // Close all dropdowns first
    allDropdowns.forEach(d => {
      d.classList.remove('open');
      d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
    });
    // Toggle the clicked one
    if (!isOpen) {
      dropdown.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }
  });
});

// Hamburger toggle. Locks the page behind the open menu (html.nav-locked) so
// scrolling the menu never scroll-chains to the page.
const hamburger = document.getElementById('nav-hamburger');
const mobileMenu = document.getElementById('nav-mobile');
hamburger?.addEventListener('click', () => {
  const open = mobileMenu?.classList.toggle('open');
  hamburger.setAttribute('aria-expanded', String(!!open));
  hamburger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  mobileMenu?.setAttribute('aria-hidden', String(!open));
  document.documentElement.classList.toggle('nav-locked', !!open);
});

// Collapsible mobile section groups — collapsed by default; tap a label to expand.
// The group containing the active page auto-expands on load so you land oriented.
const mobileGroups = document.querySelectorAll('.nav-mobile-group');
mobileGroups.forEach(group => {
  const label = group.querySelector('.nav-mobile-label');
  if (group.querySelector('a.active')) {
    group.classList.add('open');
    label?.setAttribute('aria-expanded', 'true');
  }
  label?.addEventListener('click', () => {
    const nowOpen = group.classList.toggle('open');
    label.setAttribute('aria-expanded', String(nowOpen));
  });
});

// If the viewport crosses to desktop while the mobile menu is open (rotate/resize),
// clear the open state + release the scroll lock — otherwise the page stays frozen
// with the (now display:none) menu still logically "open".
window.addEventListener('resize', () => {
  if (window.innerWidth > 768 && mobileMenu?.classList.contains('open')) {
    mobileMenu.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
    hamburger?.setAttribute('aria-label', 'Open menu');
    mobileMenu.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('nav-locked');
  }
});

// Close dropdown + mobile on outside click
document.addEventListener('click', () => {
  document.querySelectorAll('.nav-dropdown.open').forEach(d => {
    d.classList.remove('open');
    d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
  });
});

// Theme toggle
function applyTheme(theme: string) {
  document.documentElement.setAttribute('data-theme', theme);
  try { localStorage.setItem('hgb-theme', theme); } catch(e) {}
}

function toggleTheme() {
  const current = document.documentElement.getAttribute('data-theme');
  applyTheme(current === 'dark' ? 'light' : 'dark');
}

document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

// Admin nav reveal — the "Admin" link ships hidden and is unhidden ONLY for admins.
// Gate: a session token must exist (logged-in), then confirm is_admin via
// /v1/admin/whoami. The result is cached in sessionStorage so we call whoami at most
// once per browser session; logged-out visitors never call it at all. This is a UI
// affordance only — the real boundary is the API's isAdminUser gate on the data.
(function revealAdminNav() {
  try {
    const token = localStorage.getItem('hgb_session');
    if (!token) return;
    const reveal = () =>
      document.querySelectorAll<HTMLElement>('.nav-admin-item').forEach((el) => { el.style.display = ''; });
    const cached = sessionStorage.getItem('hgb_is_admin');
    if (cached === '1') { reveal(); return; }
    if (cached === '0') return;
    // Bearer-only (NO credentials:'include') — the /v1/admin/* CORS preflight
    // allows the Authorization header but not credentialed requests, so adding
    // credentials makes the browser reject it. Matches the other admin pages.
    fetch('https://api.hockeygamebot.com/v1/admin/whoami', {
      headers: { Authorization: 'Bearer ' + token },
    })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (d && d.is_admin) { sessionStorage.setItem('hgb_is_admin', '1'); reveal(); }
        else { sessionStorage.setItem('hgb_is_admin', '0'); }
      })
      .catch(() => { /* nav affordance only — failure just leaves it hidden */ });
  } catch { /* localStorage blocked → stay hidden */ }
})();
</script>
