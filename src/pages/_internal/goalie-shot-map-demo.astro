---
// Quick comparison: A) grid heatmap, B) small fixed circles — both goalie's-view orientation
// Swayman 2025-26 data hardcoded for instant local preview (no React islands needed)
import { loadGoalies } from '../../lib/stats-loader';
const goalies = loadGoalies();
const swayman = goalies.find(g => g.slug?.includes('swayman')) ?? goalies[0];
const bins = (swayman.shot_bins ?? []).filter(b => b.shots != null && b.shots > 0);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Shot Map Variants — Demo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@700&family=Barlow+Condensed:wght@800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #EFEEE8; font-family: 'JetBrains Mono', monospace; padding: 40px; }
    h1 { font-family: 'Barlow Condensed', sans-serif; font-size: 28px; font-weight: 800;
         text-transform: uppercase; color: #0d0d14; margin-bottom: 8px; }
    .meta { font-size: 11px; color: rgba(13,13,20,0.45); letter-spacing: 0.08em; margin-bottom: 40px; }
    .variants { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; max-width: 900px; }
    .card { background: #fff; border: 1px solid rgba(13,13,20,0.14); padding: 20px; }
    .label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
             color: rgba(13,13,20,0.40); margin-bottom: 4px; }
    .sublabel { font-size: 9px; color: rgba(13,13,20,0.30); letter-spacing: 0.06em; margin-bottom: 14px; }
    .legend { display: flex; align-items: center; gap: 12px; margin-top: 10px; }
    .leg-dot { width: 8px; height: 8px; border-radius: 50%; }
    .leg-txt { font-size: 9px; letter-spacing: 0.08em; color: rgba(13,13,20,0.45); }
    svg { display: block; width: 100%; }
    /* tooltip */
    #tip { position: fixed; display: none; background: #0d0d14; color: #EFEEE8;
           font-family: 'JetBrains Mono', monospace; font-size: 10px; padding: 6px 10px;
           pointer-events: none; z-index: 100; white-space: nowrap; line-height: 1.7; border-radius: 2px; }
  </style>
</head>
<body>

<h1>Goalie Shot Map Variants</h1>
<div class="meta">Jeremy Swayman · BOS · 2025–26 · Goalie's view (slot at top, blue line at bottom)</div>

<div class="variants">

  <!-- ── VARIANT A: Grid Heatmap ── -->
  <div class="card">
    <div class="label">A — Grid Heatmap</div>
    <div class="sublabel">Fixed cells · color = ΔSV% · opacity = confidence</div>
    {(() => {
      // Coordinate system: goalie looking outward
      // x=80 (slot) at TOP, x=20 (far) at BOTTOM
      // y=-40 (left board) → y=+40 (right board)
      const W = 200, H = 260;
      const xs = [20,30,40,50,60,70,80];
      const ys = [-40,-30,-20,-10,0,10,20,30,40];
      // Map x → SVG y (x=80 at top=10, x=20 at bottom=H-10)
      const svgY = (x: number) => 10 + ((80 - x) / 60) * (H - 20);
      // Map y → SVG x (y=-40 left, y=+40 right)
      const svgX = (y: number) => 10 + ((y + 40) / 80) * (W - 20);
      const cellW = (W - 20) / 8;  // 9 y-bins
      const cellH = (H - 20) / 6;  // 7 x-bins (x=80 to x=20, step 10)

      function cellColor(sv: number | null | undefined, lg: number | null | undefined, shots: number) {
        if (sv == null || lg == null || shots < 5) return 'rgba(13,13,20,0.07)';
        const d = sv - lg;
        const mag = Math.min(Math.abs(d) / 0.08, 1);
        const conf = Math.min(shots / 60, 1);
        const a = (0.15 + conf * 0.70).toFixed(2);
        if (d > 0.005) return `rgba(${Math.round(20-20*mag)},${Math.round(140+60*mag)},${Math.round(60-60*mag)},${a})`;
        if (d < -0.005) return `rgba(${Math.round(210+32*mag)},${Math.round(30-30*mag)},${Math.round(40-40*mag)},${a})`;
        return `rgba(130,130,130,${a})`;
      }

      const binMap = new Map(bins.map(b => [`${b.x},${b.y}`, b]));

      return (
        <svg viewBox={`0 0 ${W} ${H}`} style="width:100%">
          {/* Rink zone background */}
          <rect x="10" y="10" width={W-20} height={H-20} fill="#E8F4F8" rx="3"/>
          {/* Goal crease line at top (x=80 side) */}
          <line x1="10" y1={svgY(80)+cellH/2} x2={W-10} y2={svgY(80)+cellH/2}
            stroke="rgba(232,0,45,0.40)" stroke-width="1.5"/>
          {/* Blue line at bottom (x=20 side) */}
          <line x1="10" y1={svgY(20)-cellH/2} x2={W-10} y2={svgY(20)-cellH/2}
            stroke="rgba(20,100,200,0.45)" stroke-width="1.5" stroke-dasharray="4 3"/>
          {/* Cells */}
          {xs.map(x => ys.map(y => {
            const b = binMap.get(`${x},${y}`);
            const cy = svgY(x) - cellH/2;
            const cx = svgX(y) - cellW/2;
            const fill = cellColor(b?.sv_pct, b?.league_sv_pct, b?.shots ?? 0);
            const shots = b?.shots ?? 0;
            return (
              <rect x={cx.toFixed(1)} y={cy.toFixed(1)}
                width={cellW.toFixed(1)} height={cellH.toFixed(1)}
                fill={fill} stroke="#fff" stroke-width="1.5"
                rx="1"
                class="cell"
                data-x={x} data-y={y}
                data-shots={shots} data-goals={b?.goals ?? 0}
                data-sv={b?.sv_pct} data-lg={b?.league_sv_pct}
                style="cursor:crosshair"
              />
            );
          }))}
          {/* Labels */}
          <text x={W/2} y="8" text-anchor="middle" font-family="JetBrains Mono,monospace"
            font-size="5.5" fill="rgba(232,0,45,0.55)" letter-spacing="0.10em">SLOT</text>
          <text x={W/2} y={H-1} text-anchor="middle" font-family="JetBrains Mono,monospace"
            font-size="5.5" fill="rgba(20,100,200,0.55)" letter-spacing="0.10em">BLUE LINE</text>
        </svg>
      );
    })()}
    <div class="legend">
      <div class="leg-dot" style="background:#15803d;opacity:0.85"></div>
      <span class="leg-txt">BETTER THAN LEAGUE</span>
      <div class="leg-dot" style="background:#E8002D;opacity:0.85"></div>
      <span class="leg-txt">WORSE</span>
    </div>
  </div>

  <!-- ── VARIANT B: Small Fixed Circles ── -->
  <div class="card">
    <div class="label">B — Small Fixed Circles</div>
    <div class="sublabel">Cap radius 7px · opacity = confidence · color = ΔSV%</div>
    {(() => {
      const W = 200, H = 260;
      const xs = [20,30,40,50,60,70,80];
      const ys = [-40,-30,-20,-10,0,10,20,30,40];
      const svgY = (x: number) => 10 + ((80 - x) / 60) * (H - 20);
      const svgX = (y: number) => 10 + ((y + 40) / 80) * (W - 20);

      function dotColor(sv: number | null | undefined, lg: number | null | undefined, shots: number) {
        if (sv == null || lg == null || shots < 5) return { fill:'rgba(13,13,20,0.12)', stroke:'rgba(13,13,20,0.18)' };
        const d = sv - lg;
        const mag = Math.min(Math.abs(d) / 0.08, 1);
        const conf = Math.min(shots / 60, 1);
        const a = (0.25 + conf * 0.60).toFixed(2);
        const sa = (parseFloat(a) + 0.15).toFixed(2);
        if (d > 0.005) return { fill:`rgba(${Math.round(20-20*mag)},${Math.round(140+60*mag)},${Math.round(60-60*mag)},${a})`, stroke:`rgba(${Math.round(20-20*mag)},${Math.round(140+60*mag)},${Math.round(60-60*mag)},${sa})` };
        if (d < -0.005) return { fill:`rgba(${Math.round(210+32*mag)},${Math.round(30-30*mag)},${Math.round(40-40*mag)},${a})`, stroke:`rgba(${Math.round(210+32*mag)},${Math.round(30-30*mag)},${Math.round(40-40*mag)},${sa})` };
        return { fill:`rgba(130,130,130,${a})`, stroke:`rgba(130,130,130,${sa})` };
      }

      const binMap = new Map(bins.map(b => [`${b.x},${b.y}`, b]));
      const R = 6.5;

      return (
        <svg viewBox={`0 0 ${W} ${H}`} style="width:100%">
          <rect x="10" y="10" width={W-20} height={H-20} fill="#E8F4F8" rx="3"/>
          <line x1="10" y1={svgY(80)} x2={W-10} y2={svgY(80)}
            stroke="rgba(232,0,45,0.40)" stroke-width="1.5"/>
          <line x1="10" y1={svgY(20)} x2={W-10} y2={svgY(20)}
            stroke="rgba(20,100,200,0.45)" stroke-width="1.5" stroke-dasharray="4 3"/>
          {xs.map(x => ys.map(y => {
            const b = binMap.get(`${x},${y}`);
            const cy = svgY(x);
            const cx = svgX(y);
            const { fill, stroke } = dotColor(b?.sv_pct, b?.league_sv_pct, b?.shots ?? 0);
            return (
              <circle cx={cx.toFixed(1)} cy={cy.toFixed(1)} r={R}
                fill={fill} stroke={stroke} stroke-width="1"
                class="dot"
                data-x={x} data-y={y}
                data-shots={b?.shots ?? 0} data-goals={b?.goals ?? 0}
                data-sv={b?.sv_pct} data-lg={b?.league_sv_pct}
                style="cursor:crosshair"
              />
            );
          }))}
          <text x={W/2} y="8" text-anchor="middle" font-family="JetBrains Mono,monospace"
            font-size="5.5" fill="rgba(232,0,45,0.55)" letter-spacing="0.10em">SLOT</text>
          <text x={W/2} y={H-1} text-anchor="middle" font-family="JetBrains Mono,monospace"
            font-size="5.5" fill="rgba(20,100,200,0.55)" letter-spacing="0.10em">BLUE LINE</text>
        </svg>
      );
    })()}
    <div class="legend">
      <div class="leg-dot" style="background:#15803d;opacity:0.85"></div>
      <span class="leg-txt">BETTER THAN LEAGUE</span>
      <div class="leg-dot" style="background:#E8002D;opacity:0.85"></div>
      <span class="leg-txt">WORSE</span>
    </div>
  </div>

</div>

<div id="tip"></div>

<script is:inline>
(function() {
  var tip = document.getElementById('tip');
  function fmt(v) { return v != null ? (v*100).toFixed(1)+'%' : '—'; }
  function fmtd(sv, lg) {
    if (sv == null || lg == null) return '—';
    var d = (sv-lg)*100;
    return (d>=0?'+':'')+d.toFixed(1)+'%';
  }
  function show(e, el) {
    var x = parseInt(el.dataset.x), y = parseInt(el.dataset.y);
    var shots = parseInt(el.dataset.shots||0), goals = parseInt(el.dataset.goals||0);
    var sv = el.dataset.sv !== 'null' ? parseFloat(el.dataset.sv) : null;
    var lg = el.dataset.lg !== 'null' ? parseFloat(el.dataset.lg) : null;
    var d = sv!=null && lg!=null ? (sv-lg)*100 : null;
    var col = d==null ? '#EFEEE8' : d>0.5 ? '#4ade80' : d<-0.5 ? '#f87171' : '#EFEEE8';
    tip.innerHTML = '<b>x='+x+' · y='+(y>=0?'+':'')+y+'</b><br>'+
      shots+' shots · '+goals+' goals<br>'+
      'goalie: '+fmt(sv)+' · league: '+fmt(lg)+'<br>'+
      '<span style="color:'+col+'">Δ '+fmtd(sv,lg)+'</span>';
    tip.style.display = 'block';
    var tx = e.clientX+12, ty = e.clientY-80;
    tip.style.left = tx+'px'; tip.style.top = ty+'px';
  }
  document.querySelectorAll('.cell, .dot').forEach(function(el) {
    el.addEventListener('mouseenter', function(e) { show(e, el); });
    el.addEventListener('mousemove', function(e) {
      tip.style.left = (e.clientX+12)+'px'; tip.style.top = (e.clientY-80)+'px';
    });
    el.addEventListener('mouseleave', function() { tip.style.display='none'; });
  });
})();
</script>

</body>
</html>
