      <button class="chip">D</button>
    </div>

    <div class="chip-group">
      <button class="chip active">All Sit</button>
      <button class="chip">5v5</button>
      <button class="chip">PP</button>
    </div>

    <div class="gp-wrap">
      Min GP
      <input type="range" min="1" max="82" value="20">
      <span class="gp-val">20</span>
    </div>

    <input type="text" class="search-input" placeholder="Search player…" />
  </div>

  <!-- TABLE -->
  <div class="tbl-outer">
    <table>
      <thead>
        <tr>
          <th class="rank-th">#</th>
          <th class="name-th">Player</th>
          <th>GP</th>
          <th>G</th>
          <th>A</th>
          <th class="sorted">P</th>
          <th>SOG</th>
          <th>ixG</th>
          <th>TOI</th>
          <th>WAR</th>
          <th>IMP%</th>
        </tr>
      </thead>
      <tbody>
        {PLAYERS.map((p) => (
          <tr>
            <td class="rank-cell">{p.rank}</td>
            <td class="name-cell">
              <div class="pname-wrap">
                <a href="#player-detail" class="pname">{p.name}</a>
                <span class="psub">{p.team} &middot; {p.pos} &middot; {p.gp} GP</span>
              </div>
            </td>
            <td>{p.gp}</td>
            <td>{p.g}</td>
            <td>{p.a}</td>
            <td class="bold">{p.p}</td>
            <td>{p.sog}</td>
            <td>{p.ixg.toFixed(1)}</td>
            <td>{p.toi.toFixed(1)}</td>
            <td>{p.war >= 0 ? '+' : ''}{p.war.toFixed(1)}</td>
            <td>
              <div class="pct-wrap">
                <span class={`val ${pctClass(p.imp_p)}`}>{p.imp_p}</span>
                <span class={`rnk ${pctClass(p.imp_p)}`}>{p.imp_p}th</span>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="tbl-footer">
      <span>Showing 10 of 764 skaters &middot; sorted by Points &darr;</span>
      <div class="tbl-footer-actions">
        <button class="tbl-footer-btn">↓ CSV</button>
        <button class="tbl-footer-btn">⊡ PNG</button>
      </div>
    </div>
  </div>

  <!-- METHODOLOGY -->
  <div class="method-strip">
    <div class="method-cell">
      <div class="method-key">WAR <span class="method-badge">CORE</span></div>
      <div class="method-val">Wins Above Replacement — RAPM × total 5v5 TOI × 0.1. Controls for linemates and opponents via ridge regression. Cumulative season value.</div>
    </div>
    <div class="method-cell">
      <div class="method-key">ixG</div>
      <div class="method-val">Individual expected goals — shot quality model using location, angle, shot type, rebound, and rush context. Better signal than raw shots.</div>
    </div>
    <div class="method-cell">
      <div class="method-key">IMP%</div>
      <div class="method-val">HGB Impact percentile vs. position group. Based on average Game Score per appearance, normalized to account for role and deployment.</div>
    </div>
  </div>

</main>


