    </div>
  </div>
</section>

<main class="page-wrap">

  <!-- FILTER BAR -->
  <div class="filter-bar">
    <div class="tab-strip">
      <button class="tab-btn active">Counting</button>
      <button class="tab-btn">Rates / 60</button>
