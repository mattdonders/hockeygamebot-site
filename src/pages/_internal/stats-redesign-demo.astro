---
// HGB Stats — Design Exploration Demo
// Viewable at /internal/stats-redesign-demo in dev
// Shows: grouped subnav, consistent masthead template, better filter UI,
//        subnav persistence on detail pages, breadcrumb navigation
// All data is mock — not connected to the stats pipeline.

interface MockPlayer {
  rank: number; slug: string; name: string; first: string; last: string;
  team: string; teamColor: string; pos: string;
  gp: number; g: number; a: number; p: number;
  sog: number; ixg: number; toi: number;
  war: number; war_p: number; imp_p: number;
}

const PLAYERS: MockPlayer[] = [
  { rank:1,  slug:'nathan-mackinnon', name:'Nathan MacKinnon', first:'Nathan', last:'MacKinnon', team:'COL', teamColor:'#6F263D', pos:'C',  gp:78, g:51, a:82, p:133, sog:312, ixg:52.1, toi:22.1, war:4.2,  war_p:96, imp_p:97 },
  { rank:2,  slug:'leon-draisaitl',   name:'Leon Draisaitl',   first:'Leon',   last:'Draisaitl', team:'EDM', teamColor:'#FF4C00', pos:'C',  gp:82, g:52, a:79, p:131, sog:298, ixg:48.7, toi:21.8, war:4.0,  war_p:94, imp_p:95 },
  { rank:3,  slug:'nikita-kucherov',  name:'Nikita Kucherov',  first:'Nikita', last:'Kucherov',  team:'TBL', teamColor:'#002868', pos:'RW', gp:80, g:42, a:88, p:130, sog:251, ixg:39.2, toi:20.9, war:3.7,  war_p:91, imp_p:93 },
  { rank:4,  slug:'connor-mcdavid',   name:'Connor McDavid',   first:'Connor', last:'McDavid',   team:'EDM', teamColor:'#FF4C00', pos:'C',  gp:70, g:32, a:87, p:119, sog:201, ixg:35.1, toi:22.4, war:3.9,  war_p:93, imp_p:94 },
  { rank:5,  slug:'auston-matthews',  name:'Auston Matthews',  first:'Auston', last:'Matthews',  team:'TOR', teamColor:'#00205B', pos:'C',  gp:79, g:58, a:44, p:102, sog:318, ixg:51.8, toi:21.2, war:3.2,  war_p:87, imp_p:89 },
  { rank:6,  slug:'matthew-tkachuk',  name:'Matthew Tkachuk',  first:'Matthew',last:'Tkachuk',   team:'FLA', teamColor:'#C8102E', pos:'LW', gp:82, g:34, a:65, p:99,  sog:228, ixg:32.4, toi:19.8, war:2.9,  war_p:82, imp_p:84 },
  { rank:7,  slug:'david-pastrnak',   name:'David Pastrnak',   first:'David',  last:'Pastrnak',  team:'BOS', teamColor:'#FFB81C', pos:'RW', gp:82, g:47, a:49, p:96,  sog:287, ixg:43.6, toi:20.1, war:2.8,  war_p:80, imp_p:82 },
  { rank:8,  slug:'mitch-marner',     name:'Mitch Marner',     first:'Mitch',  last:'Marner',    team:'VGK', teamColor:'#B4975A', pos:'RW', gp:82, g:28, a:67, p:95,  sog:198, ixg:28.9, toi:20.5, war:2.6,  war_p:76, imp_p:78 },
  { rank:9,  slug:'cale-makar',       name:'Cale Makar',       first:'Cale',   last:'Makar',     team:'COL', teamColor:'#6F263D', pos:'D',  gp:77, g:24, a:68, p:92,  sog:212, ixg:30.4, toi:24.1, war:3.4,  war_p:89, imp_p:91 },
  { rank:10, slug:'jack-hughes',      name:'Jack Hughes',      first:'Jack',   last:'Hughes',    team:'NJD', teamColor:'#CE1126', pos:'C',  gp:75, g:34, a:54, p:88,  sog:232, ixg:37.1, toi:21.0, war:2.7,  war_p:78, imp_p:80 },
];

function pctClass(v: number): string {
  if (v >= 90) return 'pct-e';
  if (v >= 70) return 'pct-g';
  if (v >= 40) return 'pct-a';
  return 'pct-l';
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Stats Redesign Demo — HGB</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ── TOKENS ─────────────────────────────────────────────────── */
    :root {
      --bg:       #EFEEE8;
      --surface:  #FFFFFF;
      --ink:      #0d0d14;
      --red:      #E8002D;
      --green:    #166534;
      --ink-04:   rgba(13,13,20,.04);
      --ink-06:   rgba(13,13,20,.06);
      --ink-10:   rgba(13,13,20,.10);
      --ink-14:   rgba(13,13,20,.14);
      --ink-20:   rgba(13,13,20,.20);
      --ink-32:   rgba(13,13,20,.32);
      --ink-48:   rgba(13,13,20,.48);
      --ink-56:   rgba(13,13,20,.56);
      --ink-72:   rgba(13,13,20,.72);
      --grid-line:rgba(13,13,20,.04);
      --display:  'Barlow Condensed', sans-serif;
      --body:     'Barlow', sans-serif;
      --mono:     'JetBrains Mono', monospace;
      --nav-h:    58px;
      --sub-h:    38px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: var(--bg); color: var(--ink); font-family: var(--body); -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }

    /* ── DEMO BANNER ────────────────────────────────────────────── */
    .demo-banner {
      background: var(--ink); color: var(--bg); padding: 7px 32px;
      font-family: var(--mono); font-size: 10px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase; text-align: center;
    }
    .demo-banner em { color: var(--red); font-style: normal; }

    /* ── NAV ────────────────────────────────────────────────────── */
    .nav {
      background: var(--bg); border-bottom: 1px solid var(--ink-14);
      height: var(--nav-h); position: sticky; top: 0; z-index: 100;
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 32px;
      height: 100%; display: flex; align-items: center;
    }
    .wordmark {
      font-family: var(--display); font-weight: 800; font-size: 20px;
      letter-spacing: .04em; text-transform: lowercase; flex-shrink: 0;
    }
    .wordmark em { color: var(--red); font-style: normal; }
    .nav-links {
      margin-left: 28px; margin-right: auto;
      display: flex; align-items: center;
      font-family: var(--body); font-weight: 700; font-size: 12px;
      letter-spacing: .08em; text-transform: uppercase;
    }
    .nav-links > a, .nav-dd-trigger {
      padding: 4px 11px; color: var(--ink-48);
      transition: color .12s; white-space: nowrap;
      background: none; border: none; cursor: pointer;
      font: inherit; display: flex; align-items: center; gap: 3px;
    }
    .nav-links > a:hover, .nav-dd-trigger:hover { color: var(--ink); }
    .nav-links > a.active, .nav-dd.active .nav-dd-trigger { color: var(--ink); }
    .nav-sep { color: var(--ink-20); padding: 0 1px; }
    .nav-caret { font-size: 8px; opacity: .4; }

    /* Dropdown — NEW: shows groups */
    .nav-dd { position: relative; display: inline-flex; }
    .nav-dd-menu {
      display: none; position: absolute;
      top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
      min-width: 200px; background: var(--surface);
      border: 1.5px solid var(--ink-14); box-shadow: 0 8px 24px var(--ink-10);
      z-index: 200; padding: 6px 0;
    }
    .nav-dd:hover .nav-dd-menu { display: block; }
    .dd-group-label {
      font-family: var(--mono); font-size: 9px; font-weight: 700;
      letter-spacing: .14em; text-transform: uppercase; color: var(--ink-32);
      padding: 8px 16px 4px;
    }
    .dd-group-label:not(:first-child) {
      border-top: 1px solid var(--ink-06); padding-top: 10px; margin-top: 4px;
    }
    .nav-dd-menu a {
      display: block; padding: 6px 16px;
      font-family: var(--body); font-weight: 600; font-size: 12px;
      letter-spacing: .05em; color: var(--ink-56);
      transition: background .1s, color .1s;
    }
    .nav-dd-menu a:hover { background: var(--ink-04); color: var(--ink); }
    .nav-dd-menu a.active { color: var(--ink); font-weight: 700; }

    .nav-account {
      font-family: var(--body); font-weight: 600; font-size: 11px;
      letter-spacing: .06em; text-transform: uppercase; color: var(--ink-32);
    }
    .nav-account:hover { color: var(--ink); }

    /* ── SUBNAV — NEW GROUPED DESIGN ────────────────────────────── */
    /*
     * KEY CHANGE: Groups replace the flat 13-item scroll.
     * NHL group = primary tables, always first.
     * Tools group = analytical tools.
     * History group = historical records.
     * PWHL group = visually separated, labeled distinctly.
     */
    .stats-subnav {
      background: var(--surface); border-bottom: 1px solid var(--ink-14);
      position: sticky; top: var(--nav-h); z-index: 90;
      overflow-x: auto; scrollbar-width: none;
    }
    .stats-subnav::-webkit-scrollbar { display: none; }
    .stats-subnav-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 32px;
      display: flex; align-items: stretch; min-height: var(--sub-h);
    }
    .sn-group {
      display: flex; align-items: stretch;
    }
    .sn-group + .sn-group {
      border-left: 1px solid var(--ink-10);
      margin-left: 6px; padding-left: 2px;
    }
    .sn-label {
      display: flex; align-items: center; padding: 0 6px 0 10px;
      font-family: var(--mono); font-size: 8.5px; font-weight: 700;
      letter-spacing: .14em; text-transform: uppercase;
      color: var(--ink-32); white-space: nowrap; flex-shrink: 0;
    }
    .sn-label.pwhl { color: #1763a0; }
    .stats-subnav a {
      display: flex; align-items: center; padding: 0 11px;
      height: var(--sub-h);
      font-family: var(--body); font-size: 11px; font-weight: 700;
      letter-spacing: .07em; text-transform: uppercase;
      color: var(--ink-48); white-space: nowrap;
      transition: color .1s, background .1s;
    }
    .stats-subnav a:hover { color: var(--ink); background: var(--ink-04); }
    .stats-subnav a.active {
      color: var(--ink);
      box-shadow: inset 0 -2px 0 var(--red);
    }

    /* ── MASTHEAD ────────────────────────────────────────────────── */
    /*
     * KEY CHANGE: One masthead pattern for all leaderboard pages.
     * No ghost-text variant on leaderboards (that's for tools pages only).
     * Standardized eyebrow: Barlow body weight-500, middot separator.
     * Consistent padding.
     */
    .mast {
      position: relative; border-bottom: 2px solid var(--ink);
      background-color: var(--bg);
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 96px 96px;
    }
    .mast-corners { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
    .mc { position: absolute; width: 14px; height: 14px; }
    .mc.tl { top:16px; left:16px;   border-top:1px solid var(--ink-20); border-left:1px solid var(--ink-20); }
    .mc.tr { top:16px; right:16px;  border-top:1px solid var(--ink-20); border-right:1px solid var(--ink-20); }
    .mc.bl { bottom:16px; left:16px;  border-bottom:1px solid var(--ink-20); border-left:1px solid var(--ink-20); }
    .mc.br { bottom:16px; right:16px; border-bottom:1px solid var(--ink-20); border-right:1px solid var(--ink-20); }
    .mast-inner {
      position: relative; z-index: 2;
      max-width: 1200px; margin: 0 auto; padding: 32px 32px 26px;
    }
    .mast-top {
      display: flex; align-items: baseline; justify-content: space-between; gap: 24px;
      margin-bottom: 16px;
    }
    .mast-eyebrow {
      font-family: var(--body); font-weight: 500; font-size: 11px;
      letter-spacing: .12em; text-transform: uppercase; color: var(--ink-48);
      display: flex; align-items: center; gap: 7px;
    }
    .eyebrow-pip {
      width: 5px; height: 5px; background: var(--red); border-radius: 50%; flex-shrink: 0;
    }
    .mast-qualifier {
      font-family: var(--mono); font-size: 10px; color: var(--ink-32); letter-spacing: .06em;
    }
    .mast-card {
      background: var(--surface); border: 1px solid var(--ink);
      padding: 24px 28px 20px;
    }
    .mast-headline {
      font-family: var(--display); font-weight: 800;
      font-size: clamp(32px, 5vw, 60px);
      text-transform: uppercase; line-height: 1; letter-spacing: -.01em;
      margin-bottom: 10px;
    }
    .mast-headline em { color: var(--red); font-style: normal; }
    .mast-lede { font-size: 13px; color: var(--ink-48); line-height: 1.6; max-width: 580px; }

    /* ── PAGE LAYOUT ─────────────────────────────────────────────── */
    .page-wrap { max-width: 1200px; margin: 0 auto; padding: 28px 32px 80px; }

    /* ── FILTER BAR — NEW DESIGN ─────────────────────────────────── */
    /*
     * KEY CHANGE: Tab strip replaces scattered per-page toggle patterns.
     * Chip groups replace native <select> for pos/situation.
     * Consistent height across all stats pages.
     */
    .filter-bar {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .tab-strip {
      display: inline-flex; border: 1px solid var(--ink-14);
      background: var(--surface); overflow: hidden; flex-shrink: 0;
    }
    .tab-btn {
      padding: 6px 14px;
      font-family: var(--body); font-weight: 700; font-size: 11px;
      letter-spacing: .08em; text-transform: uppercase;
      color: var(--ink-48); background: none; border: none;
      cursor: pointer; border-right: 1px solid var(--ink-14); white-space: nowrap;
      transition: background .1s, color .1s;
    }
    .tab-btn:last-child { border-right: none; }
    .tab-btn.active { background: var(--ink); color: var(--bg); }
    .tab-btn:hover:not(.active) { background: var(--ink-04); color: var(--ink); }

    .chip-group {
      display: inline-flex; border: 1px solid var(--ink-14);
      background: var(--surface); overflow: hidden;
    }
    .chip {
      padding: 6px 11px;
      font-family: var(--body); font-weight: 600; font-size: 11px;
      letter-spacing: .05em; text-transform: uppercase;
      color: var(--ink-48); background: none; border: none;
      cursor: pointer; border-right: 1px solid var(--ink-14); white-space: nowrap;
      transition: background .1s, color .1s;
    }
    .chip:last-child { border-right: none; }
    .chip.active { background: var(--ink-10); color: var(--ink); }
    .chip:hover:not(.active) { background: var(--ink-04); color: var(--ink); }

    .gp-wrap {
      display: flex; align-items: center; gap: 6px;
      font-family: var(--mono); font-size: 10px; color: var(--ink-48);
    }
    .gp-wrap input[type=range] { width: 80px; accent-color: var(--red); }
    .gp-val { min-width: 20px; color: var(--ink-72); font-weight: 600; }

    .search-input {
      margin-left: auto; background: var(--surface);
      border: 1px solid var(--ink-14); padding: 6px 12px;
      font-family: var(--body); font-size: 12px; color: var(--ink); outline: none;
      min-width: 170px; transition: border-color .15s;
    }
    .search-input:focus { border-color: var(--ink-48); }
    .search-input::placeholder { color: var(--ink-32); font-weight: 400; }

    /* ── TABLE ───────────────────────────────────────────────────── */
    .tbl-outer {
      background: var(--surface); border: 1px solid var(--ink-14); overflow-x: auto;
    }
    table {
      width: 100%; border-collapse: collapse; min-width: 680px;
    }
    thead th {
      font-family: var(--mono); font-size: 10px; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: var(--ink-48); text-align: right;
      padding: 10px 12px; border-bottom: 1px solid var(--ink-14);
      white-space: nowrap; background: var(--surface);
      user-select: none;
    }
    thead th:hover { color: var(--ink-72); cursor: pointer; }
    thead th.sorted { color: var(--ink); }
    thead th.sorted::after { content: ' ↓'; font-size: 8px; }
    thead th.rank-th { text-align: center; width: 36px; }
    thead th.name-th { text-align: left; min-width: 190px; }
    tbody tr {
      border-bottom: 1px solid var(--ink-06); cursor: pointer;
    }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover td { background: var(--ink-04); }
    td {
      padding: 8px 12px; text-align: right;
      font-family: var(--mono); font-size: 11.5px;
      color: var(--ink-72); white-space: nowrap;
    }
    td.rank-cell { text-align: center; font-size: 10px; color: var(--ink-32); }
    td.name-cell { text-align: left; }
    .pname-wrap { display: flex; flex-direction: column; gap: 1px; }
    .pname {
      font-family: var(--body); font-weight: 700; font-size: 13px; color: var(--ink);
    }
    .pname:hover { color: var(--red); }
    .psub {
      font-family: var(--mono); font-size: 9.5px; color: var(--ink-32); letter-spacing: .04em;
    }
    td.bold { font-weight: 700; color: var(--ink); font-size: 12.5px; }

    /* Percentile cell: value over percentile rank */
    .pct-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
    .pct-wrap .val { font-weight: 700; font-size: 11.5px; }
    .pct-wrap .rnk { font-size: 9px; font-weight: 600; }
    .pct-e { color: #00c070; }
    .pct-g { color: #60a5fa; }
    .pct-a { color: var(--ink-48); }
    .pct-l { color: var(--red); opacity: .7; }

    .tbl-footer {
      padding: 10px 14px; border-top: 1px solid var(--ink-06);
      font-family: var(--mono); font-size: 10px; color: var(--ink-32);
      display: flex; justify-content: space-between; align-items: center;
    }
    .tbl-footer-actions {
      display: flex; gap: 12px;
    }
    .tbl-footer-btn {
      font-family: var(--mono); font-size: 10px; font-weight: 600;
      letter-spacing: .08em; color: var(--ink-48); background: none; border: none;
      cursor: pointer; display: flex; align-items: center; gap: 4px;
      transition: color .1s;
    }
    .tbl-footer-btn:hover { color: var(--ink); }

    /* ── METHODOLOGY ─────────────────────────────────────────────── */
    .method-strip {
      background: var(--surface); border: 1px solid var(--ink-14);
      display: grid; grid-template-columns: repeat(3, 1fr);
      margin-top: 32px;
    }
    .method-cell {
      padding: 18px 20px; border-right: 1px solid var(--ink-06);
    }
    .method-cell:last-child { border-right: none; }
    .method-key {
      font-family: var(--body); font-weight: 700; font-size: 12px;
      letter-spacing: .06em; text-transform: uppercase;
      color: var(--ink); margin-bottom: 6px;
      display: flex; align-items: center; gap: 8px;
    }
    .method-badge {
      font-size: 9px; font-weight: 700; letter-spacing: .1em;
      padding: 1px 5px; color: var(--red);
      border: 1px solid rgba(232,0,45,.4);
    }
    .method-val { font-size: 12px; color: var(--ink-48); line-height: 1.55; }

    /* ── DEMO DIVIDER ────────────────────────────────────────────── */
    .demo-div {
      max-width: 1200px; margin: 60px auto 0; padding: 0 32px;
    }
    .demo-div-inner {
      border-top: 2px solid var(--ink); padding-top: 14px;
      display: flex; align-items: center; gap: 16px;
    }
    .demo-tag {
      font-family: var(--mono); font-size: 9px; font-weight: 700;
      letter-spacing: .16em; text-transform: uppercase; color: var(--ink-32);
      white-space: nowrap;
    }
    .demo-tag-line { flex: 1; height: 1px; background: var(--ink-10); }

    /* ── BREADCRUMB ──────────────────────────────────────────────── */
    /*
     * KEY CHANGE: Player detail pages need a breadcrumb + persistent subnav.
     * Currently player pages are navigation dead-ends (no subnav, no breadcrumb).
     * The breadcrumb lives between the subnav and the player masthead.
     */
    .breadcrumb {
      background: var(--surface); border-bottom: 1px solid var(--ink-10);
    }
    .breadcrumb-inner {
      max-width: 1200px; margin: 0 auto; padding: 8px 32px;
      font-family: var(--mono); font-size: 10px; color: var(--ink-32);
      letter-spacing: .06em; display: flex; align-items: center; gap: 6px;
    }
    .breadcrumb a { color: var(--ink-48); transition: color .1s; }
    .breadcrumb a:hover { color: var(--red); }
    .bc-sep { color: var(--ink-20); }
    .bc-current { color: var(--ink); }

    /* ── PLAYER MASTHEAD ─────────────────────────────────────────── */
    .player-mast {
      position: relative; border-bottom: 2px solid var(--ink);
      background-color: var(--bg);
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 96px 96px;
    }
    .player-mast-inner {
      max-width: 1200px; margin: 0 auto; padding: 24px 32px 20px;
    }
    .player-card {
      background: var(--surface); border: 1px solid var(--ink);
      display: grid; grid-template-columns: 5px 1fr auto;
      gap: 0; overflow: hidden;
    }
    .player-card-bar { /* team color accent */
      background: #6F263D; /* COL */
      grid-row: 1 / -1;
    }
    .player-card-body { padding: 20px 24px; }
    .player-eyebrow {
      font-family: var(--body); font-weight: 500; font-size: 10px;
      letter-spacing: .14em; text-transform: uppercase; color: var(--ink-48);
      display: flex; align-items: center; gap: 6px; margin-bottom: 10px;
    }
    .player-name-h1 {
      font-family: var(--display); font-weight: 800;
      font-size: clamp(28px, 4vw, 52px);
      text-transform: uppercase; line-height: 1; letter-spacing: -.01em;
      margin-bottom: 6px;
    }
    .player-meta-row {
      font-family: var(--mono); font-size: 10.5px; color: var(--ink-48);
      letter-spacing: .05em; display: flex; align-items: center; gap: 10px;
    }
    .player-meta-sep { color: var(--ink-20); }
    .player-card-stats {
      padding: 20px 24px; display: flex; flex-direction: column;
      justify-content: center; gap: 14px; border-left: 1px solid var(--ink-06);
    }
    .pstat-row { display: flex; gap: 20px; }
    .pstat {
      display: flex; flex-direction: column; align-items: flex-end; gap: 2px;
    }
    .pstat-val {
      font-family: var(--display); font-weight: 800; font-size: 26px;
      line-height: 1; color: var(--ink); letter-spacing: -.01em;
    }
    .pstat-key {
      font-family: var(--mono); font-size: 8.5px; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase; color: var(--ink-48);
    }

    /* Tab bar inside player page (game log / career / shots) */
    .player-tabs {
      background: var(--surface); border-bottom: 1px solid var(--ink-14);
    }
    .player-tabs-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 32px;
      display: flex; gap: 0;
    }
    .player-tab {
      padding: 10px 16px; font-family: var(--body); font-weight: 700;
      font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
      color: var(--ink-48); border-bottom: 2px solid transparent;
      transition: color .1s; cursor: pointer; white-space: nowrap;
    }
    .player-tab.active { color: var(--ink); border-bottom-color: var(--red); }
    .player-tab:hover:not(.active) { color: var(--ink-72); }

    /* ── FOOTER ──────────────────────────────────────────────────── */
    /*
     * KEY CHANGE: One footer pattern for all stats pages.
     * Current site has two incompatible footer patterns (lb-footer vs foot).
     */
    .site-footer-wrap {
      border-top: 1px solid var(--ink-14); margin-top: 40px;
    }
    .site-footer {
      max-width: 1200px; margin: 0 auto; padding: 18px 32px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 20px; flex-wrap: wrap;
    }
    .foot-wordmark {
      font-family: var(--display); font-weight: 800; font-size: 17px;
      letter-spacing: .04em; text-transform: uppercase;
    }
    .foot-wordmark em { color: var(--red); font-style: normal; }
    .foot-meta {
      font-family: var(--mono); font-size: 9.5px; color: var(--ink-32);
      letter-spacing: .06em;
    }

    /* ── RESPONSIVE ──────────────────────────────────────────────── */
    @media (max-width: 768px) {
      .mast-inner, .page-wrap, .player-mast-inner,
      .breadcrumb-inner, .player-tabs-inner,
      .demo-div, .site-footer { padding-left: 16px; padding-right: 16px; }
      .stats-subnav-inner { padding: 0 16px; }
      .player-card { grid-template-columns: 4px 1fr; }
      .player-card-stats { display: none; }
      .method-strip { grid-template-columns: 1fr; }
      .method-cell { border-right: none; border-bottom: 1px solid var(--ink-06); }
    }
  </style>
</head>
