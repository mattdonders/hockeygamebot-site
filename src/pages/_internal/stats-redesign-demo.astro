<script>
// Range slider live value
document.querySelector('input[type=range]')?.addEventListener('input', function(e) {
  const target = e.target as HTMLInputElement;
  const val = target.closest('.gp-wrap')?.querySelector('.gp-val');
  if (val) val.textContent = target.value;
});
// Tab/chip toggle (visual only)
document.querySelectorAll('.tab-btn, .chip').forEach(btn => {
  btn.addEventListener('click', function() {
    const group = this.closest('.tab-strip, .chip-group');
    group?.querySelectorAll('.tab-btn, .chip').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
  });
});
