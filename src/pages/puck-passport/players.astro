---
// HockeyGameBot — /puck-passport/players — the full players-seen list, ranked by
// games seen. A static route (this file, not the [handle] dynamic route, wins
// for this exact path — same precedence as games.astro/arenas.astro) that mounts
// PassportPlayers — a thin wrapper around AttendedTracker's "players-only"
// render variant, so the list is the exact same code the /puck-passport
// dashboard's Players Seen preview uses. See PassportPlayers.tsx.
import Base from '../../layouts/Base.astro';
import PassportPlayers from '../../components/react/PassportPlayers.tsx';
// Same shared stylesheet as the dashboard (src/pages/puck-passport.astro), the
// public profile page, /puck-passport/games and /puck-passport/arenas — single
// source of truth for Puck Passport look.
import '../../styles/puck-passport.css';
---

<Base
  title="Your Players · Puck Passport"
  description="Your full Puck Passport players-seen list — every NHL player you've watched in person, ranked by games seen."
  currentPath={Astro.url.pathname}
>
  <!-- Shared canvas-export surface (window.HGB_Export) — powers the ticket-stub share. -->
  <script is:inline src="/js/table-export.js" slot="head"></script>

  <!-- MASTHEAD (simpler than the dashboard's — this is a management view, not the highlight) -->
  <section class="att-mast">
    <div class="att-mast-ghost">PLAYERS</div>
    <div class="att-mast-corners"><div class="att-corner tl"></div><div class="att-corner tr"></div></div>
    <div class="att-wrap att-mast-inner">
      <div class="att-mast-top">
        <span class="att-mast-top-eyebrow"><span class="pip"></span> HockeyGameBot · Puck Passport</span>
      </div>
      <div class="att-mast-card">
        <div class="att-mast-cardtop">
          <span class="att-eyebrow">Player History</span>
        </div>
        <h1 class="att-headline">Players Seen</h1>
        <p class="att-sub">Every player you've seen play, and what you personally witnessed from them.</p>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="att-body">
    <div class="att-wrap">
      <PassportPlayers client:only="react" />
    </div>
  </section>
</Base>
