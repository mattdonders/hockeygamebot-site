---
// HockeyGameBot — public Puck Passport profile (/puck-passport/@{handle}).
//
// Static host, arbitrary handle: this single shell is served for every
// /puck-passport/@* path via a Cloudflare `_redirects` 200-rewrite (see
// public/_redirects). The client-only island reads the handle from the URL and
// fetches GET /v1/passport/:handle — read-only, no auth.
//
// Reuses the shared Puck Passport CSS so a public profile matches the owner's
// own dashboard exactly.
import Base from '../../layouts/Base.astro';
import PublicPassport from '../../components/react/PublicPassport.tsx';
import '../../styles/puck-passport.css';
---

<Base
  title="Puck Passport · HockeyGameBot"
  description="A fan's public Puck Passport — every NHL game attended in person, with badges, home rinks collected, and team records."
  currentPath="/puck-passport"
>
  <PublicPassport client:only="react" />
</Base>
