---
// HockeyGameBot — /puck-passport/games — full attended-game history.
// A static route (this file, not the [handle] dynamic route, wins for this exact
// path) that mounts PassportGames — a thin wrapper around AttendedTracker's
// "games-only" render variant, so the list + its remove/stub actions are the
// exact same code the /puck-passport dashboard uses. See PassportGames.tsx.
import Base from '../../layouts/Base.astro';
import PassportGames from '../../components/react/PassportGames.tsx';
// Same shared stylesheet as the dashboard (src/pages/puck-passport.astro) and the
// public profile page — single source of truth for Puck Passport look.
import '../../styles/puck-passport.css';
---

<Base
  title="Your Games · Puck Passport"
  description="Your full Puck Passport game history — every NHL game you've logged, in one place."
  currentPath={Astro.url.pathname}
>
  <!-- Shared canvas-export surface (window.HGB_Export) — powers the ticket-stub share. -->
  <script is:inline src="/js/table-export.js" slot="head"></script>

  <!-- MASTHEAD (simpler than the dashboard's — this is a management view, not the highlight) -->
  <section class="att-mast">
    <div class="att-mast-ghost">GAMES</div>
    <div class="att-mast-corners"><div class="att-corner tl"></div><div class="att-corner tr"></div></div>
    <div class="att-wrap att-mast-inner">
      <div class="att-mast-top">
        <span class="att-mast-top-eyebrow"><span class="pip"></span> HockeyGameBot · Puck Passport</span>
      </div>
      <div class="att-mast-card">
        <div class="att-mast-cardtop">
          <span class="att-eyebrow">Game History</span>
        </div>
        <h1 class="att-headline">Your Games</h1>
        <p class="att-sub">Every NHL game you've logged to your Puck Passport.</p>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="att-body">
    <div class="att-wrap">
      <PassportGames client:only="react" />
    </div>
  </section>
</Base>
