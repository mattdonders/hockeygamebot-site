---
// HockeyGameBot — /puck-passport/arenas — full home-rinks collection + per-venue
// visit breakdown. A static route (this file, not the [handle] dynamic route,
// wins for this exact path — same precedence as games.astro) that mounts
// PassportArenas — a thin wrapper around AttendedTracker's "arenas-only" render
// variant, so the meter + breakdown are the exact same code the /puck-passport
// dashboard uses. See PassportArenas.tsx.
import Base from '../../layouts/Base.astro';
import PassportArenas from '../../components/react/PassportArenas.tsx';
// Same shared stylesheet as the dashboard (src/pages/puck-passport.astro), the
// public profile page, and /puck-passport/games — single source of truth for
// Puck Passport look.
import '../../styles/puck-passport.css';
---

<Base
  title="Your Arenas · Puck Passport"
  description="Your full Puck Passport arena collection — every NHL home rink you've logged, plus a building-by-building visit breakdown."
  currentPath={Astro.url.pathname}
>
  <!-- Shared canvas-export surface (window.HGB_Export) — powers the ticket-stub share. -->
  <script is:inline src="/js/table-export.js" slot="head"></script>

  <!-- MASTHEAD (simpler than the dashboard's — this is a management view, not the highlight) -->
  <section class="att-mast">
    <div class="att-mast-ghost">ARENAS</div>
    <div class="att-mast-corners"><div class="att-corner tl"></div><div class="att-corner tr"></div></div>
    <div class="att-wrap att-mast-inner">
      <div class="att-mast-top">
        <span class="att-mast-top-eyebrow"><span class="pip"></span> HockeyGameBot · Puck Passport</span>
      </div>
      <div class="att-mast-card">
        <div class="att-mast-cardtop">
          <span class="att-eyebrow">Arena History</span>
        </div>
        <h1 class="att-headline">Your Arenas</h1>
        <p class="att-sub">Every NHL home rink you've collected, and every building you've logged a game at.</p>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="att-body">
    <div class="att-wrap">
      <PassportArenas client:only="react" />
    </div>
  </section>
</Base>
