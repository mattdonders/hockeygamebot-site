---
// HockeyGameBot — /admin — private analytics dashboard (Puck Passport, for now).
//
// SOFT-404 GATING: a static page can't return a real HTTP 404 for non-admins (the
// session token lives in localStorage, unreadable server-side — see the island
// header). So the server ships THREE states and reveals the right one client-side:
//   #admin-loading  — shown first, neutral, no admin chrome
//   #admin-notfound — the site's not-found view (default for anyone who isn't admin)
//   #admin-content  — mast + hub + dashboard, revealed ONLY after /v1/admin/whoami
//                     confirms is_admin. Nothing admin-looking renders otherwise, so
//                     a logged-out / non-admin visitor sees a plain 404.
// The real security boundary remains the API's isAdminUser gate on the data itself;
// this is just so the page doesn't advertise that an admin surface exists here.
import Base from '../layouts/Base.astro';
import AdminDashboard from '../components/react/AdminDashboard.tsx';
---

<Base title="HockeyGameBot" description="" currentPath={Astro.url.pathname}>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  {/* Neutral first paint — swapped out the instant the gate script resolves. */}
  <div id="admin-loading" class="admin-state"></div>

  {/* Default for non-admins: looks like any other not-found page. */}
  <div id="admin-notfound" class="admin-state" style="display:none">
    <div class="admin-404-code">404</div>
    <div class="admin-404-msg">This page could not be found.</div>
    <a href="/" class="admin-404-link">← Back to HockeyGameBot</a>
  </div>

  {/* Admin-only: hidden until whoami confirms is_admin. */}
  <div id="admin-content" style="display:none">
    <div class="admin-mast">
      <div class="admin-mast-inner">
        <div>
          <div class="admin-eyebrow"><span class="admin-pip"></span>HGB Admin · Puck Passport</div>
          <h1 class="admin-title">Puck Passport Analytics</h1>
        </div>
        <div class="admin-user" id="admin-user-display"></div>
      </div>
    </div>
    <div class="admin-page-body">
      <nav class="admin-hub">
        <span class="admin-hub-label">Admin tools →</span>
        <a href="/admin/insights">Insights</a>
        <a href="/admin/generator">Card Generator</a>
        <a href="/admin/player-compare">Player Compare</a>
      </nav>
      <AdminDashboard client:only="react" />
    </div>
  </div>
</Base>

<style>
  .admin-state { min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 10px; }
  .admin-404-code { font-family: "Barlow Condensed", sans-serif; font-weight: 800; font-size: 72px; line-height: 1; color: var(--ink, #0d0d14); }
  .admin-404-msg { font-size: 15px; color: var(--ink-60, #6b6b78); }
  .admin-404-link { font-size: 14px; color: var(--red, #E8002D); text-decoration: none; margin-top: 6px; }
  .admin-404-link:hover { text-decoration: underline; }

  /* Shared admin-mast chrome (mirrors /admin/insights + /admin/generator). */
  .admin-mast { border-bottom: 2px solid var(--ink); background: var(--bg); }
  .admin-mast-inner {
    max-width: 1040px; margin: 0 auto; padding: 20px 20px;
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  }
  .admin-eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 9px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--red);
    margin-bottom: 6px; display: flex; align-items: center; gap: 6px;
  }
  .admin-pip { width: 5px; height: 5px; background: var(--red); border-radius: 50%; }
  .admin-title {
    font-family: "Barlow Condensed", sans-serif; font-weight: 800;
    font-size: clamp(24px, 3vw, 36px); text-transform: uppercase; letter-spacing: -0.005em; margin: 0;
  }
  .admin-user {
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px;
    color: var(--ink-48, #7a7a86); letter-spacing: 0.06em;
  }

  .admin-page-body { max-width: 1040px; margin: 0 auto; padding: 24px 20px 80px; }

  .admin-hub { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; font-size: 13px; }
  .admin-hub-label {
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-48, #7a7a86);
    align-self: center; margin-right: 4px;
  }
  .admin-hub a {
    padding: 5px 12px; border: 1px solid var(--ink-14, #dcdce2); border-radius: 8px;
    background: var(--surface, #fff); color: inherit; text-decoration: none;
  }
  .admin-hub a:hover { border-color: var(--ink-48, #7a7a86); }
</style>

<script is:inline>
  // Client-side gate: reveal the dashboard ONLY for a confirmed admin; everyone else
  // sees the 404 state. Bearer-only fetch (the /v1/admin/* preflight rejects
  // credentialed requests). Fail-closed: no token / non-admin / any error ⇒ 404.
  (function () {
    var loading = document.getElementById('admin-loading');
    var notfound = document.getElementById('admin-notfound');
    var content = document.getElementById('admin-content');
    function show(el) {
      [loading, notfound, content].forEach(function (x) { if (x) x.style.display = x === el ? '' : 'none'; });
    }
    function deny() { show(notfound); try { document.title = '404 · HockeyGameBot'; } catch (e) {} }

    var token;
    try { token = localStorage.getItem('hgb_session'); } catch (e) {}
    if (!token) { deny(); return; }

    fetch('https://api.hockeygamebot.com/v1/admin/whoami', {
      headers: { Authorization: 'Bearer ' + token },
    })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (d && d.is_admin) {
          var el = document.getElementById('admin-user-display');
          if (el && d.email) el.textContent = 'signed in as ' + d.email;
          show(content);
        } else {
          deny();
        }
      })
      .catch(function () { deny(); });
  })();
</script>
