---
// HockeyGameBot — /admin — private analytics dashboard (Puck Passport, for now).
// The page shell is public HTML but contains NO data: everything is loaded by the
// AdminDashboard island via the admin-gated /v1/admin/passport/stats endpoint,
// which returns 403 for non-admins. See the island header for the auth rationale
// (localStorage Bearer token ⇒ client-side fetch, not SSR).
//
// Uses the shared `.admin-mast` header chrome for visual parity with the other
// admin tools (/admin/insights, /admin/generator). Fonts are pinned explicitly
// (not via --display/--mono, which those standalone pages define locally) so the
// mast renders correctly under the Base layout.
import Base from '../layouts/Base.astro';
import AdminDashboard from '../components/react/AdminDashboard.tsx';
---

<Base title="Admin · HockeyGameBot" description="Private analytics." currentPath={Astro.url.pathname}>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <div class="admin-mast">
    <div class="admin-mast-inner">
      <div>
        <div class="admin-eyebrow"><span class="admin-pip"></span>HGB Admin · Puck Passport</div>
        <h1 class="admin-title">Puck Passport Analytics</h1>
      </div>
      <div class="admin-user" id="admin-user-display"></div>
    </div>
  </div>

  <div class="admin-page-body">
    {/* Admin hub strip — /admin is the index of the admin namespace. */}
    <nav class="admin-hub">
      <span class="admin-hub-label">Admin tools →</span>
      <a href="/admin/insights">Insights</a>
      <a href="/admin/generator">Card Generator</a>
      <a href="/admin/player-compare">Player Compare</a>
    </nav>
    <AdminDashboard client:only="react" />
  </div>
</Base>

<style>
  /* Shared admin-mast chrome (mirrors /admin/insights + /admin/generator). */
  .admin-mast { border-bottom: 2px solid var(--ink); background: var(--bg); }
  .admin-mast-inner {
    max-width: 1040px; margin: 0 auto; padding: 20px 20px;
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  }
  .admin-eyebrow {
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 9px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--red);
    margin-bottom: 6px; display: flex; align-items: center; gap: 6px;
  }
  .admin-pip { width: 5px; height: 5px; background: var(--red); border-radius: 50%; }
  .admin-title {
    font-family: "Barlow Condensed", sans-serif; font-weight: 800;
    font-size: clamp(24px, 3vw, 36px); text-transform: uppercase; letter-spacing: -0.005em; margin: 0;
  }
  .admin-user {
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px;
    color: var(--ink-48, #7a7a86); letter-spacing: 0.06em;
  }

  .admin-page-body { max-width: 1040px; margin: 0 auto; padding: 24px 20px 80px; }

  .admin-hub { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; font-size: 13px; }
  .admin-hub-label {
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-48, #7a7a86);
    align-self: center; margin-right: 4px;
  }
  .admin-hub a {
    padding: 5px 12px; border: 1px solid var(--ink-14, #dcdce2); border-radius: 8px;
    background: var(--surface, #fff); color: inherit; text-decoration: none;
  }
  .admin-hub a:hover { border-color: var(--ink-48, #7a7a86); }
</style>

<script is:inline>
  // Populate the mast's "signed in as" line (parity with the other admin pages).
  // Best-effort + non-gating — the island owns the real auth states; this is chrome.
  (function () {
    try {
      var token = localStorage.getItem('hgb_session');
      if (!token) return;
      fetch('https://api.hockeygamebot.com/v1/admin/whoami', {
        headers: { Authorization: 'Bearer ' + token },
        credentials: 'include',
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (d && d.email) {
            var el = document.getElementById('admin-user-display');
            if (el) el.textContent = 'signed in as ' + d.email + (d.is_admin ? '' : ' · not admin');
          }
        })
        .catch(function () {});
    } catch (e) {}
  })();
</script>
